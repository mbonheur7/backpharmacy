# Copy this file to .env and fill in real values. Never commit the real .env file.

# Full SQLAlchemy connection string for PostgreSQL.
# Local example:   postgresql+psycopg2://vipharmacy:vipharmacy@localhost:5432/vipharmacy
# Render/Railway will give you a DATABASE_URL directly — if it starts with
# "postgres://", change the prefix to "postgresql+psycopg2://" (SQLAlchemy 2.x
# requires the explicit driver name).
DATABASE_URL=postgresql+psycopg2://vipharmacy:vipharmacy@localhost:5432/vipharmacy

# Used later (Stage 3 — Flask backend) for session cookie signing.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-deploying

# Initial admin account, read only by seed_admin.py. Change the password
# immediately after first login, then it's safe to leave these as-is or
# remove them from .env — seed_admin.py is never run automatically.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-this-before-seeding
SEED_ADMIN_FULLNAME=System Administrator

# Lockout policy (Stage 3 will read these; defined here so config.py has one home)
LOCKOUT_MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
